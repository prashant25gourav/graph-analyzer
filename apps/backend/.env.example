# Backend environment variables (copy to apps/backend/.env for local dev).

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Groq API (get a key at https://console.groq.com). Read ONLY from the env.
GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=qwen/qwen3.6-27b

# Comma-separated list of allowed browser origins (frontend URLs).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upload + request limits
MAX_UPLOAD_MB=8
REQUEST_TIMEOUT_SECONDS=45

# PORT is provided by the host (e.g. Render). Locally, uvicorn --port controls it.
